# CoinCync Node Configuration
# Copy to ~/.coincync/coincync.conf and edit as needed

# Network: testnet or mainnet
network = testnet

# Data directory
data-dir = /data/coincync

# RPC bind address (set to 0.0.0.0 to allow external access)
rpc-bind = 127.0.0.1:28081

# P2P bind address
p2p-bind = 0.0.0.0:28080

# Seed nodes (testnet) — optional extras; built-in DNS + seeds match src/testnet.rs
# addnode = 66.135.23.193:28080    # seed1 — New York
# addnode = 140.82.57.168:28080    # seed2 — Amsterdam
# addnode = 207.148.111.76:28080   # seed3 — Tokyo
# addnode = 207.148.6.50:28080     # explorer — Dallas

# Mining (uncomment to mine)
# mining-threads = 4
# mining-address = tCYNC3Z...your_address_here

# Logging
log-level = info
