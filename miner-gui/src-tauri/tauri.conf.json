{
  "build": {
    "distDir": "../src",
    "devPath": "../src"
  },
  "package": {
    "productName": "CoinCync Miner",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "all": false, "open": true },
      "process": { "all": true },
      "fs": { "all": false }
    },
    "bundle": {
      "active": true,
      "identifier": "network.coincync.miner",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.ico"
      ],
      "targets": "all",
      "windows": {
        "wix": {
          "language": "en-US"
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "CoinCync Miner",
        "width": 900,
        "height": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  }
}
