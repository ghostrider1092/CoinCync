# /etc/coincync/coord.env — environment for coincync-coord.service
#
# Copy to /etc/coincync/coord.env on the deploy host and fill in the
# secret. The .service file expects this exact path; the deploy script
# (deploy-coord.ps1) writes it for you on first run.
#
# Permissions: chmod 0600, chown coincync-coord:coincync-coord — the
# invite-secret HMAC key is the root of trust for participant attaches.

# Listen address. Plain WS on loopback only; nginx terminates WSS in
# front. If you ever change this to a public interface, the unit's
# IPAddressDeny=any will refuse to forward — that's intentional.
COINCYNC_COORD_LISTEN=127.0.0.1:8443

# State file. Append-only-ish SessionStore — the coord writes every
# transition here. ReadWritePaths in the unit lists /var/lib/coincync-coord
# explicitly so this path is the only writable location.
COINCYNC_COORD_STATE=/var/lib/coincync-coord/sessions.json

# Invitation-token HMAC key. 32-byte hex (64 hex chars). Generate with:
#   openssl rand -hex 32
# Treat this like a key — losing it lets anyone with the bytes forge
# attach invitations; rotating it invalidates every outstanding invite.
COINCYNC_COORD_INVITE_SECRET=__REPLACE_WITH_HEX32__

# Optional: idle-connection timeout, max-attaches-per-second, etc.
# Defer to coord defaults until traffic pattern is known.
# COINCYNC_COORD_IDLE_TIMEOUT_SECS=300
# COINCYNC_COORD_ATTACH_RATE=10
