# /etc/coincync/rig.env  (chmod 640, root:coincync)  — DO NOT COMMIT WITH A REAL KEY
#
# The RPC Bearer key — MUST match the shared box's node key exactly. The rig's
# --api-key flag reads this env var, so the rig authenticates to the node's RPC.
COINCYNC_RPC_API_KEY=REPLACE_WITH_THE_SAME_KEY_AS_THE_NODE
