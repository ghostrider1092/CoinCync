# /etc/coincync/node.env  (chmod 640, root:coincync)  — DO NOT COMMIT WITH A REAL KEY
#
# The RPC Bearer key. Generate once with `openssl rand -hex 32` and use the SAME
# value on the rig box (rig.env) and in /etc/coincync/rpc.key (for the tick).
# The node refuses a non-loopback --rpc-bind unless this is set.
COINCYNC_RPC_API_KEY=REPLACE_WITH_openssl_rand_hex_32
