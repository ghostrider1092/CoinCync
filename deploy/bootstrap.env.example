# CoinCync signed bootstrap manifest environment template
#
# Copy to /etc/coincync/bootstrap.env (or similar), then set real paths/keys.
# Use with systemd:
#   EnvironmentFile=/etc/coincync/bootstrap.env
#   ExecStartPre=/usr/bin/python3 /opt/coincync/scripts/preflight_bootstrap_manifest.py

# Required: signed manifest JSON
COINCYNC_BOOTSTRAP_SIGNED_MANIFEST=/etc/coincync/bootstrap_seeds.json

# Required: Ed25519 public key (32-byte hex) used to verify manifest signatures
COINCYNC_BOOTSTRAP_SIGNING_PUBKEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: signature file path (defaults to <manifest>.sig if unset)
COINCYNC_BOOTSTRAP_SIGNED_MANIFEST_SIG=/etc/coincync/bootstrap_seeds.json.sig

# Recommended hardened mode: only trust signed manifest peers
COINCYNC_BOOTSTRAP_MANIFEST_ONLY=1

# Additional hardening (still useful if not manifest-only)
COINCYNC_BOOTSTRAP_DISABLE_DNS=1

# Optional allowlist filter (comma-separated ip:port)
# COINCYNC_BOOTSTRAP_SEED_ALLOWLIST=66.135.23.193:28080,140.82.57.168:28080
